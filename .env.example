# Optional for local/VPS scheduled automation runner
CRON_SECRET=replace-with-a-long-random-secret
EVENTFLOW_URL=http://127.0.0.1:3000

# Vercel/serverless persistent storage.
# Connect an Upstash Redis database from the Vercel Marketplace; Vercel/Upstash
# will inject one of these supported variable pairs automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Some Vercel integrations expose these aliases instead. EventFlow supports both.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: use a different Redis key if you intentionally share one Redis DB
# across multiple EventFlow demo deployments.
EVENTFLOW_STATE_KEY=eventflow:state:v1
